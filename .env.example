# Nimbus configuration. Copy this file to `.env` to customize.
# All values are optional.

# Port and network interface. Keep 127.0.0.1 for local-only access.
PORT=8787
HOST=127.0.0.1

# Where the database, cache and local storage live.
DATA_DIR=./data

# Set to true when running behind a reverse proxy (nginx, Caddy, Cloudflare Tunnel).
TRUST_PROXY=false

# Maximum accepted upload size in megabytes. 0 means no app-level limit.
# Raise this to upload files larger than 4 GiB. On GitHub, Nimbus splits large
# files into 1 GiB assets (up to 100 GiB per file); GitHub still limits a
# repository to about 100 GB and a release to 1,000 assets.
MAX_UPLOAD_MB=4096

# Session lifetime in days.
SESSION_DAYS=30

# Public URL, used only for display in the console (optional).
PUBLIC_URL=

# Initial cache limit in MB. Once changed in Settings, the stored value wins.
# 0 disables automatic caching; explicit offline pins still work.
CACHE_LIMIT_MB=8192

# Log verbosity: fatal, error, warn, info, debug or trace.
LOG_LEVEL=info
